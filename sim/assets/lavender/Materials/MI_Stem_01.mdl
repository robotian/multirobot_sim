mdl 1.6;

import ::math::*;
import ::state::*;
import ::tex::*;
import ::anno::*;
import ::scene::*;
using OmniUe4Function import *;
using OmniUe4Subsurface import *;

export annotation sampler_color();
export annotation sampler_normal();
export annotation sampler_grayscale();
export annotation sampler_alpha();
export annotation sampler_masks();
export annotation sampler_distancefield();
export annotation dither_masked_off();
export annotation world_space_normal();

export material MI_Stem_01(
	float Flatness_S_ = 0.0
	[[
		anno::display_name("Flatness (S)"),
		anno::in_group("03 - Normal Detail")
	]],
	float4 TintColor = float4(0.437093,0.854167,0.298069,1.0)
	[[
		anno::display_name("Tint Color"),
		anno::in_group("01 - Albedo")
	]],
	float4 ColorFresnel = float4(0.243245,0.317708,0.271951,1.0)
	[[
		anno::display_name("Color Fresnel"),
		anno::in_group("01 - Fresnel (on Albedo)")
	]],
	float TilingNoise = 1.0
	[[
		anno::display_name("Tiling Noise"),
		anno::ui_order(2),
		anno::in_group("01 - Albedo")
	]],
	float ContrastNoise = 0.5
	[[
		anno::display_name("Contrast Noise"),
		anno::ui_order(3),
		anno::in_group("01 - Albedo")
	]],
	float Specular = 0.25
	[[
		anno::display_name("Specular"),
		anno::in_group("02 - Reflectivity")
	]],
	float3 SubsurfaceColor = float3(0.55, 0.80, 0.35)
	[[
		anno::display_name("Subsurface Color"),
		anno::description("Tint of light transmitted through the thin stem geometry from behind -- 0 disables translucency entirely."),
		anno::in_group("07 - Subsurface")
	]],
	float SubsurfaceOpacity = 0.6
	[[
		anno::display_name("Subsurface Opacity"),
		anno::description("1.0 = fully opaque (no light passes through). Lower values let more light transmit through the stem."),
		anno::in_group("07 - Subsurface")
	]],
	float Roughness = 0.75
	[[
		anno::display_name("Roughness"),
		anno::ui_order(1),
		anno::in_group("02 - Reflectivity")
	]],
	float WindSpeedMultiplier = 1.0
	[[
		anno::display_name("Wind Speed Multiplier")
	]],
	float WindSpeed_S_ = 1.0
	[[
		anno::display_name("WindSpeed (S)"),
		anno::ui_order(5),
		anno::in_group("05 - Wind (if activated, this override the values from the Material Collection Parameter)")
	]],
	float TilingWindTurbulence = 5.0
	[[
		anno::display_name("Tiling Wind Turbulence"),
		anno::ui_order(1),
		anno::in_group("05 - Wind (if activated, this override the values from the Material Collection Parameter)")
	]],
	float WPOIntensity = 2.0
	[[
		anno::display_name("WPO Intensity"),
		anno::ui_order(2),
		anno::in_group("05 - Wind (if activated, this override the values from the Material Collection Parameter)")
	]],
	int NumberInstances = 0
	[[
		anno::hidden()
	]],
	float WindIntensityMultiplier = 1.5
	[[
		anno::display_name("Wind Intensity Multiplier")
	]],
	float WindWeight = 0.0
	[[
		anno::display_name("Wind Weight"),
		anno::ui_order(3),
		anno::in_group("05 - Wind (if activated, this override the values from the Material Collection Parameter)")
	]],
	float WindIntensity = 1.0
	[[
		anno::display_name("Wind Intensity"),
		anno::ui_order(4),
		anno::in_group("05 - Wind (if activated, this override the values from the Material Collection Parameter)")
	]],
	float ObjectRadius_S_ = 0.4
	[[
		anno::display_name("Object Radius (S)"),
		anno::ui_order(32),
		anno::in_group("06 - Object Size (for Wind)")
	]],
	float Contrast_S_ = 2.0
	[[
		anno::display_name("Contrast (S)"),
		anno::ui_order(32),
		anno::in_group("06 - Object Size (for Wind)")
	]],
	int MaxTexCoordIndex = 3
	[[
		anno::hidden()
	]])
[[
	distill_off()
]]
 = 
	let {
	float3 Local10 = math::normalize(float3(float4(0.0,1.0,0.0,1.0).x,float4(0.0,1.0,0.0,1.0).y,float4(0.0,1.0,0.0,1.0).z));
	float Local11 = (WindSpeedMultiplier * WindSpeed_S_);
	float Local12 = (Local11 / 10.0);
	float Local13 = (state::animation_time() * Local12);
	float Local14 = (Local13 * -0.5);
	float Local15 = (float4(0.0,1.0,0.0,1.0).w * Local14);
	float3 Local16 = (Local10 * Local15);
	float3 Local17 = ((::convert_to_left_hand(state::transform_point(state::coordinate_internal,state::coordinate_world,state::position()), true)*state::meters_per_scene_unit()*100.0) / 1024.0);
	float3 Local18 = (Local16 + Local17);
	float3 Local19 = (Local18 + 0.5);
	float3 Local20 = math::frac(Local19);
	float3 Local21 = (Local20 * 2.0);
	float3 Local22 = (Local21 + -1.0);
	float3 Local23 = math::abs(Local22);
	float3 Local24 = (Local23 * 2.0);
	float3 Local25 = (3.0 - Local24);
	float3 Local26 = (Local25 * Local23);
	float3 Local27 = (Local26 * Local23);
	float Local28 = math::dot(Local10, Local27);
	float3 Local29 = ((::convert_to_left_hand(state::transform_point(state::coordinate_internal,state::coordinate_world,state::position()), true)*state::meters_per_scene_unit()*100.0) / 200.0);
	float3 Local30 = (Local15 + Local29);
	float3 Local31 = (Local30 + 0.5);
	float3 Local32 = math::frac(Local31);
	float3 Local33 = (Local32 * 2.0);
	float3 Local34 = (Local33 + -1.0);
	float3 Local35 = math::abs(Local34);
	float3 Local36 = (Local35 * 2.0);
	float3 Local37 = (3.0 - Local36);
	float3 Local38 = (Local37 * Local35);
	float3 Local39 = (Local38 * Local35);
	float3 Local40 = (Local39 - 0.0);
	float Local41 = math::length(Local40);
	float Local42 = (Local28 + Local41);
	float Local43 = (Local42 * 6.283185);
	float3 Local44 = math::cross(Local10,float3(0.0,0.0,1.0));
	float Local45 = math::frac(Local13);
	float Local46 = (TilingWindTurbulence / 1000.0);
	float2 Local47 = (float2((::convert_to_left_hand(state::transform_point(state::coordinate_internal,state::coordinate_world,state::position()), true)*state::meters_per_scene_unit()*100.0).x,(::convert_to_left_hand(state::transform_point(state::coordinate_internal,state::coordinate_world,state::position()), true)*state::meters_per_scene_unit()*100.0).y) * Local46);
	float2 Local48 = (float2(Local45,Local45) + Local47);
	float4 Local49 = ::greyscale_texture_lookup(tex::lookup_float4(texture_2d("./Textures/LowResBlurredNoise.png",::tex::gamma_linear),float2(Local48.x,1.0-Local48.y),tex::wrap_repeat,tex::wrap_repeat));
	float Local50 = (WPOIntensity * Local49.x);
	float Local51 = (Local49.x + Local50);
	float Local52 = math::min(math::max(::per_instance_random(texture_2d("./Textures/PerlinNoiseGradientTexture.png",tex::gamma_linear), NumberInstances),0.5),10.0);
	float Local53 = (Local52 * WindIntensityMultiplier);
	float Local54 = (1.0 - Local53);
	float Local55 = math::lerp(Local51,2.5,Local54);
	float3 Local56 = (Local55 + float3(0.0,0.0,-10.0));
	float3 Local57 = ::rotate_about_axis(float4(Local44.x,Local44.y,Local44.z,Local43),Local56,float3(Local55,Local55,Local55));
	float3 Local58 = (Local57 * WindWeight);
	float3 Local59 = (Local58 * Local49.x);
	float3 Local60 = (Local59 + Local55);
	float Local61 = (WindIntensityMultiplier * WindIntensity);
	float3 Local62 = (Local60 * Local61);
	float3 Local63 = ((::convert_to_left_hand(state::transform_point(state::coordinate_internal,state::coordinate_world,state::position()), true)*state::meters_per_scene_unit()*100.0) - ::object_world_position(true));
	float Local64 = (::object_radius() * ObjectRadius_S_);
	float Local65 = (Local63.z / Local64);
	float Local66 = math::min(math::max(Local65,-1.0),1.0);
	float Local67 = (1.0 + Local66);
	float Local68 = (Local67 * 0.5);
	float Local69 = math::pow(math::max(Local68,float(0.000001)),Contrast_S_);
	float3 Local70 = math::lerp(float3(0.0,0.0,0.0),Local62,Local69);

	float3 WorldPositionOffset_mdl = Local70;
	float2 CustomizedUV0_mdl = float2(state::texture_coordinate(math::min(0,MaxTexCoordIndex)).x,1.0-state::texture_coordinate(math::min(0,MaxTexCoordIndex)).y);

	float4 Local0 = ::unpack_normal_map(tex::lookup_float4(texture_2d("./Textures/T_Lavender_Stem_Normal.png",::tex::gamma_linear),float2(CustomizedUV0_mdl.x,1.0-CustomizedUV0_mdl.y),tex::wrap_repeat,tex::wrap_repeat));
	float3 Local1 = math::lerp(float3(Local0.x,Local0.y,Local0.z),float3(0.0,0.0,1.0),Flatness_S_);

	float3 Normal_mdl = Local1;

	float4 Local2 = tex::lookup_float4(texture_2d("./Textures/T_Lavender_Stem_Albedo.png",::tex::gamma_srgb),float2(CustomizedUV0_mdl.x,1.0-CustomizedUV0_mdl.y),tex::wrap_repeat,tex::wrap_repeat);
	float3 Local3 = (float3(TintColor.x,TintColor.y,TintColor.z) * float3(Local2.x,Local2.y,Local2.z));
	float Local4 = ::fresnel(5.0, 0.04, ::pixel_normal_world_space(true));
	float3 Local5 = math::lerp(Local3,float3(ColorFresnel.x,ColorFresnel.y,ColorFresnel.z),Local4);
	float2 Local6 = (CustomizedUV0_mdl * TilingNoise);
	float4 Local7 = tex::lookup_float4(texture_2d("./Textures/T_Sky_Stars.png",::tex::gamma_srgb),float2(Local6.x,1.0-Local6.y),tex::wrap_repeat,tex::wrap_repeat);
	float3 Local8 = math::pow(math::max(float3(Local7.x,Local7.y,Local7.z),float3(0.000001)),float3(ContrastNoise,ContrastNoise,ContrastNoise));
	float3 Local9 = math::lerp(Local5,float3(1.0,1.0,1.0),Local8);

	float3 EmissiveColor_mdl = float3(0.0,0.0,0.0);
	// See MI_Lavender_Flower_Branch_01.mdl for why these two were hardcoded to 1.0/black: at opacity=1.0 the
	// OmniUe4Subsurface BSDF's real diffuse_transmission_bsdf lobe gets exactly zero weight, and the other half
	// of its fixed 50% "subsurface" weight was a reflection lobe tinted pure black -- wasting half the stem's
	// own shading budget on nothing, which is a direct contributor to it reading as too dark.
	float Opacity_mdl = SubsurfaceOpacity;
	float OpacityMask_mdl = 1.0;
	float3 BaseColor_mdl = Local9;
	float Metallic_mdl = 0.0;
	float Specular_mdl = Specular;
	float Roughness_mdl = Roughness;
	float3 SubsurfaceColor_mdl = SubsurfaceColor;
	float SurfaceThickness_mdl = 0.01;
	float Displacement_mdl = 0.0;

	} in
		::OmniUe4Subsurface(
			base_color: BaseColor_mdl,
			metallic: Metallic_mdl,
			roughness: Roughness_mdl,
			specular: Specular_mdl,
			normal: Normal_mdl,
			opacity: Opacity_mdl,
			emissive_color: EmissiveColor_mdl,
			displacement: WorldPositionOffset_mdl,
			opacity_mask: OpacityMask_mdl,
			subsurface_color: SubsurfaceColor_mdl,
			two_sided: false);
