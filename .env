# Address the WebRTC client uses to reach Isaac Sim (this machine's LAN IP, or 127.0.0.1 for local-only).
ISAACSIM_HOST=127.0.0.1
# Number of robots (0-8): robot containers a300_0000 ... and the robots spawned in the sim. Change it with
# scripts/fleet.sh <N>, which also removes robot containers that are no longer wanted.
NUM_ROBOTS=1
# ROBOT_MODEL_<i> (i = 0..7) sets slot i's model (a300/a200/j100/r100, default a300); only slots < NUM_ROBOTS
# actually start (slot i needs NUM_ROBOTS > i), see the "Robot models" section of README.md.
ROBOT_MODEL_0=j100_0921
# ROBOT_MODEL_1=j100_0936
COMPOSE_PROFILES=n${NUM_ROBOTS}
# ROS 2 middleware: rmw_zenoh_cpp (like the real robots; needs the zenoh-router service) or rmw_fastrtps_cpp.
FLEET_RMW=rmw_zenoh_cpp
# Zenoh router the sessions connect to. Default is the zenoh-router service; set e.g. tcp/<robot-ip>:7447 for a real one.
#ZENOH_ROUTER=tcp/zenoh-router:7447
ROS_DOMAIN_ID=0
# D435i colour/depth stream size. Cameras publish every sim frame (SIM_RATE_HZ) divided by (CAMERA_FRAME_SKIP + 1).
CAMERA_WIDTH=640
CAMERA_HEIGHT=360
CAMERA_FRAME_SKIP=0
# Frames per second of simulated time (each frame = PHYSICS_HZ / SIM_RATE_HZ physics substeps). Lower it if the
# real-time factor (FLEET_DEBUG=1) drops under 1.0; above 1.0 the sim runs faster than real time, so set it to about
# the render_fps that FLEET_DEBUG reports. The frame rate depends on the number of robots and the middleware
# (2 robots, FastDDS, async rendering: ~23 fps; 3 robots on zenoh: ~15 fps).
SIM_RATE_HZ=22
PHYSICS_HZ=60
# true: the sim publishes /clock and stamps its messages with simulation time, and every ROS node in the robot
# containers runs with use_sim_time, so robot logic keeps step with a sim slower than real time (several robots).
# false: wall-clock stamps, no /clock.
USE_SIM_TIME=true
# Extra Kit settings, "/path/a=1;/path/b=text". Async rendering overlaps the camera rendering with the rest of the frame
# (about +15-25% frame rate, camera images lag by one frame); low latency mode keeps that lag small.
FLEET_SETTINGS=/app/asyncRendering=true;/app/asyncRenderingLowLatency=true
ROBOT_HOSTNAME_0=cpr-j100-0921
ROBOT_HOSTNAME_1=cpr-j100-0921
ROBOT_HOSTNAME_2=cpr-a200-0284
ROBOT_HOSTNAME_3=cpr-j100-0922
ROBOT_HOSTNAME_4=cpr-a300-0004
ROBOT_HOSTNAME_5=cpr-a300-0005
ROBOT_HOSTNAME_6=cpr-a300-0006
ROBOT_HOSTNAME_7=cpr-a300-0007
ROBOT_MODEL_1=j100_0921
ROBOT_MODEL_2=a200_0284
ROBOT_MODEL_3=j100_0922
ROBOT_SUFFIX_1=
ROBOT_SUFFIX_2=
ROBOT_SUFFIX_3=
SIM_MODE=headed
ROBOT_LOOKS=full
SIM_SCENE=lavender_farm_chargers.usda
BASESTATION_ZENOH_CONNECT="tcp/127.0.0.1:7448 tcp/192.168.50.65:7447"
ROBOT_SUFFIX_0=
