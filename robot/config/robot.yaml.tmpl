# Clearpath A300 configuration, identical for every robot.
# The double-underscore placeholders (namespace, serial, middleware) are filled in per robot by
# robot/entrypoint.sh and scripts/gen_urdf.sh; the middleware is the one selected by FLEET_RMW in .env.
serial_number: __SERIAL__
version: 0
system:
  hosts:
    - hostname: cpr-__SERIAL__
      ip: 192.168.131.1
  ros2:
    namespace: __NS__
    middleware:
      implementation: __RMW__
platform:
  controller: ps4
  battery:
    model: S_24V20_U1
    configuration: S1P2
  attachments:
    - name: front_bumper
      type: a300.bumper
      parent: front_bumper_mount
    - name: rear_bumper
      type: a300.bumper
      parent: rear_bumper_mount
    - name: top_plate
      type: a300.top_plate
sensors:
  camera:
    - model: intel_realsense
      urdf_enabled: true
      launch_enabled: false
      parent: top_plate_link
      xyz: [0.35, 0.0, 0.05]
      rpy: [0.0, 0.0, 0.0]
      ros_parameters:
        intel_realsense:
          camera_name: camera_0
          device_type: d435i
          serial_no: "0"
