# Clearpath Ridgeback (model code r100) configuration, shared by every robot assigned this model
# (ROBOT_MODEL=r100, see .env's ROBOT_MODEL_<i>). Sibling files robot.a300/a200/j100.yaml.tmpl cover the other
# supported models.
# Ridgeback is Clearpath's holonomic mecanum-wheel platform and drives omnidirectionally in this sim: forward/
# back and rotation use the same real diff_4wd.yaml differential OmniGraph as the other models, and a separate
# BodyDrive script node patches in real sideways (linear.y) motion, which the wheels' plain cylinder collision
# geometry can't produce on its own -- see sim/scripts/setup_scene.py's MODEL_PARAMS/BODY_DRIVE_SCRIPT comments
# for the full reasoning, including a known limitation: a small *pure* in-place rotation command from a
# standstill is mostly absorbed by static friction (verified live), while a larger one or any rotation combined
# with translation comes through close to correctly.
# The double-underscore placeholders (namespace, serial, domain, middleware) are filled in per robot by
# robot/entrypoint.sh and scripts/gen_urdf.sh; the middleware is the one selected by FLEET_RMW in .env, the
# domain by ROS_DOMAIN_ID. clearpath_generator_common's `generate_bash` turns this into /etc/clearpath/setup.bash
# (see entrypoint.sh), exactly as it would on a real Clearpath robot.
serial_number: __SERIAL__
version: 0
system:
  hosts:
    - hostname: cpr-__SERIAL__
      ip: 192.168.131.1
  ros2:
    namespace: __NS__
    domain_id: __DOMAIN__
    middleware:
      implementation: __RMW__
    # The shared colcon workspace (see docker-compose.yml); generate_bash then sources it from setup.bash.
    # Must be the *install* dir, not .../install/setup.bash or the workspace root: installed
    # clearpath_generator_common 2.9.15 builds the path with `workspace.strip('setup.bash')`, which (being
    # Python's character-set strip, not a substring removal) mangles most other spellings of this path.
    workspaces:
      - /home/robot/colcon_ws/install
platform:
  controller: ps4
  mcu:
    protocol: proton
sensors:
  # Ridgeback's own default sample mounts a 2D lidar, not a camera; this project's fleet always carries the
  # D435i instead, mounted on the chassis (no top plate). xyz/rpy are an approximate, visually-checked
  # placement, not a hardware-accurate mount point.
  camera:
    - model: intel_realsense
      urdf_enabled: true
      launch_enabled: false
      parent: chassis_link
      xyz: [0.3, 0.0, 0.35]
      rpy: [0.0, 0.0, 0.0]
      ros_parameters:
        intel_realsense:
          camera_name: camera_0
          device_type: d435i
          serial_no: "0"
